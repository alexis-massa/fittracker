# Local dev value below. In production, point this at the shared Postgres
# instance owned by the sibling `territoride` repo instead (a dedicated
# `fittracker` database/role there, not territoride's own database).
DATABASE_URL=postgresql://fittracker:fittracker@localhost:5433/fittracker
APP_PORT=8080

# Starts the local dev Postgres from docker-compose.yml automatically -
# leave this set for local dev, production must NOT set it.
COMPOSE_PROFILES=dev

# Production only - domain this app is served on, and credentials
# protecting it behind Caddy's basic_auth (see the sibling
# `caddy-docker-proxy` repo for the shared reverse proxy setup).
# Generate the hash with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpassword'
FITTRACKER_DOMAIN=change-me
FITTRACKER_BASIC_AUTH_USER=change-me
FITTRACKER_BASIC_AUTH_HASH=change-me
