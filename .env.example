# Settings for local development. `just db-up` writes .env from this file the first time; never commit .env.
# On the Pi, ~/fittracker/.env is written by pi-infra's add-app.sh (DATABASE_URL) plus APP_DOMAIN.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/fittracker
APP_DOMAIN=localhost
BIND_ADDR=127.0.0.1:8080
COOKIE_SECURE=false
RUST_LOG=info

